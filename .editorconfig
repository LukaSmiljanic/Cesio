root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.{ts,tsx,js,jsx,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning

# The project names (Shared.*, Modules.*) are fixed by docs/architecture.md; "Shared" is only a keyword in VB, which is not used.
dotnet_diagnostic.CA1716.severity = none

# EF Core migrations are generated by dotnet-ef; analyzers and style rules do not apply.
[**/Migrations/*.cs]
generated_code = true
