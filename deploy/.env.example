# Copy to .env on the server (never commit it). One file per environment.
CESIO_ENVIRONMENT=Staging
CESIO_DOMAIN=staging.example.rs
GHCR_OWNER=lukasmiljanic

# Database: the administrator (only the migrator uses it) and the application login (API and worker).
MSSQL_SA_PASSWORD=
APP_DB_PASSWORD=

# Password of secrets/dataprotection.pfx (deploy/README.md: creating the certificate).
DATA_PROTECTION_CERT_PASSWORD=

# SMTP login; the server, port and sender are in appsettings.{Staging,Production}.json.
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Written by the deploy workflow for each release.
CESIO_IMAGE_DIGEST=
CESIO_WEB_IMAGE_DIGEST=
